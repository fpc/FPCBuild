#!/bin/sh
#
# Free Pascal post-installation script for deb/rpm packages.
# Copyright 1996-2026 the Free Pascal development team.
#
# The version below is filled in by the make nfpmstage target.

FPCVERSION=@FPCVERSION@
FPCDIR=/usr/lib/fpc/$FPCVERSION

if [ ! -x "$FPCDIR/samplecfg" ] ; then
  exit 0
fi

# samplecfg is given the path with a literal $fpcversion, so that the generated
# fpc.cfg keeps working when a second version is installed next to this one.
if [ -e /etc/fpc.cfg ] ; then
  echo "/etc/fpc.cfg is present and is left unchanged."
  echo "Run $FPCDIR/samplecfg '/usr/lib/fpc/\$fpcversion' to write a new one."
else
  "$FPCDIR/samplecfg" '/usr/lib/fpc/$fpcversion'
fi

if [ -x /sbin/ldconfig ] ; then
  /sbin/ldconfig
elif [ -x /usr/sbin/ldconfig ] ; then
  /usr/sbin/ldconfig
fi

exit 0
